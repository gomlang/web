package tests;

use ecosystem::web;
use std::fs;
use std::testing;
use std::time::{Duration};

#[test]
fn static_compression_revalidation_preserves_negotiated_metadata() -> () {
    let root = "_artifact/static-compression-http";
    testing::assert_ok(fs::create_dir_all(root));
    testing::assert_ok(fs::write_file_structured(root + "/file.txt", "0123456789"));
    let files = testing::expect_ok(web::StaticFiles::new(root, 100), "static files");
    defer {
        let _ = files.close();
    };
    let server = transport_server(
        web::Router::new().get("/{*path}", files.handler("path")).layer(
            testing::expect_ok(web::compression(1024), "compression"),
        ),
    );
    defer {
        let _ = server.shutdown(Duration::from_seconds(2));
    };
    let head = transport_request(
        server,
        "HEAD /file.txt HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: gzip\r\nConnection: close\r\n\r\n",
    );
    testing::assert(head.starts_with("HTTP/1.1 200 "));
    let mut etag = "";
    for line in head.split("\r\n") {
        if let Some((name, value)) = line.split_once(":") {
            if name.eq_ignore_ascii_case("etag") {
                etag = value.trim();
            }
        }
    }
    testing::assert(etag.starts_with("W/\""));
    let cached = transport_request(
        server,
        "GET /file.txt HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: gzip\r\nIf-None-Match: "
            + etag
            + "\r\nConnection: close\r\n\r\n",
    );
    testing::assert(cached.starts_with("HTTP/1.1 304 "));
    testing::assert(cached.contains("etag: " + etag + "\r\n"));
    testing::assert(cached.contains("content-encoding: gzip\r\n"));
    testing::assert(!cached.contains("content-length:"));
    testing::assert(cached.ends_with("\r\n\r\n"));
    let partial = transport_request(
        server,
        "GET /file.txt HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: gzip\r\nRange: bytes=2-4\r\nIf-Range: "
            + etag.byte_slice(2, etag.byte_len())
            + "\r\nConnection: close\r\n\r\n",
    );
    testing::assert(partial.starts_with("HTTP/1.1 206 "));
    testing::assert(partial.contains("content-range: bytes 2-4/10\r\n"));
    testing::assert(!partial.contains("content-encoding:"));
    testing::assert(partial.ends_with("\r\n\r\n234"));
    let rejected = transport_request(
        server,
        "GET /file.txt HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: *;q=0\r\nIf-None-Match: "
            + etag
            + "\r\nConnection: close\r\n\r\n",
    );
    testing::assert(rejected.starts_with("HTTP/1.1 406 "));
}

#[test]
fn static_preconditions_and_head_ranges_work_over_http() -> () {
    let root = "_artifact/static-preconditions-http";
    testing::assert_ok(fs::create_dir_all(root));
    testing::assert_ok(fs::write_file_structured(root + "/file.txt", "0123456789"));
    let files = testing::expect_ok(web::StaticFiles::new(root, 100), "static files");
    defer {
        let _ = files.close();
    };
    let server = transport_server(web::Router::new().get("/{*path}", files.handler("path")));
    defer {
        let _ = server.shutdown(Duration::from_seconds(2));
    };
    let failed = transport_request(
        server,
        "GET /file.txt HTTP/1.1\r\nHost: localhost\r\nIf-Match: \"stale\"\r\nRange: bytes=2-4\r\nConnection: close\r\n\r\n",
    );
    testing::assert(failed.starts_with("HTTP/1.1 412 Precondition Failed\r\n"));
    testing::assert(!failed.contains("content-range:"));
    testing::assert(failed.ends_with("\r\n\r\n"));
    let opaque = transport_request(
        server,
        "GET /file.txt HTTP/1.1\r\nHost: localhost\r\nIf-Match: \"prefix,*,suffix\"\r\nConnection: close\r\n\r\n",
    );
    testing::assert(opaque.starts_with("HTTP/1.1 412 Precondition Failed\r\n"));
    let uncached = transport_request(
        server,
        "GET /file.txt HTTP/1.1\r\nHost: localhost\r\nIf-None-Match: \"prefix,*,suffix\"\r\nConnection: close\r\n\r\n",
    );
    testing::assert(uncached.starts_with("HTTP/1.1 200 OK\r\n"));
    testing::assert(uncached.ends_with("\r\n\r\n0123456789"));
    let head = transport_request(
        server,
        "HEAD /file.txt HTTP/1.1\r\nHost: localhost\r\nRange: bytes=2-4\r\nIf-Match: *\r\nConnection: close\r\n\r\n",
    );
    testing::assert(head.starts_with("HTTP/1.1 200 OK\r\n"));
    testing::assert(head.to_ascii_lowercase().contains("content-length: 10\r\n"));
    testing::assert(!head.contains("content-range:"));
    testing::assert(head.ends_with("\r\n\r\n"));
    let range = transport_request(
        server,
        "GET /file.txt HTTP/1.1\r\nHost: localhost\r\nRange: bytes=2-4\r\nIf-Match: *\r\nConnection: close\r\n\r\n",
    );
    testing::assert(range.starts_with("HTTP/1.1 206 "));
    testing::assert(range.to_ascii_lowercase().contains("content-range: bytes 2-4/10\r\n"));
    testing::assert(range.ends_with("\r\n\r\n234"));
}

#[test]
fn static_range_numeric_boundaries_and_unknown_units_work_over_http() -> () {
    let root = "_artifact/static-range-http";
    testing::assert_ok(fs::create_dir_all(root));
    testing::assert_ok(fs::write_file_structured(root + "/file.txt", "0123456789"));
    testing::assert_ok(fs::write_file_structured(root + "/empty.txt", ""));
    let files = testing::expect_ok(web::StaticFiles::new(root, 100), "static files");
    defer {
        let _ = files.close();
    };
    let server = transport_server(web::Router::new().get("/{*path}", files.handler("path")));
    defer {
        let _ = server.shutdown(Duration::from_seconds(2));
    };
    for (value, status, body, length, range) in Vec::from_array(
        [
            ("bytes=2-99999999999999999999999999", "206", "23456789", "8", "bytes 2-9/10"),
            ("bytes=-99999999999999999999999999", "206", "0123456789", "10", "bytes 0-9/10"),
            ("BYTES=0-0", "206", "0", "1", "bytes 0-0/10"),
            ("bytes=99999999999999999999999999-", "416", "", "0", "bytes */10"),
            ("bytes=2-99999999999999999999999999x", "416", "", "0", "bytes */10"),
            ("items=0-1", "200", "0123456789", "10", ""),
        ],
    ) {
        let response = transport_request(
            server,
            "GET /file.txt HTTP/1.1\r\nHost: localhost\r\nRange: " + value
                + "\r\nConnection: close\r\n\r\n",
        );
        testing::assert(response.starts_with("HTTP/1.1 " + status + " "));
        testing::assert(response.contains("content-length: " + length + "\r\n"));
        testing::assert(response.ends_with("\r\n\r\n" + body));
        if range == "" {
            testing::assert(!response.contains("content-range:"));
        } else {
            testing::assert(response.contains("content-range: " + range + "\r\n"));
        }
    }
    let empty = transport_request(
        server,
        "GET /empty.txt HTTP/1.1\r\nHost: localhost\r\nRange: bytes=0-0\r\nConnection: close\r\n\r\n",
    );
    testing::assert(empty.starts_with("HTTP/1.1 416 "));
    testing::assert(empty.contains("content-range: bytes */0\r\n"));
    testing::assert(empty.ends_with("\r\n\r\n"));
    let suffix = transport_request(
        server,
        "GET /empty.txt HTTP/1.1\r\nHost: localhost\r\nRange: bytes=-99999999999999999999999999\r\nConnection: close\r\n\r\n",
    );
    testing::assert(suffix.starts_with("HTTP/1.1 200 "));
    testing::assert(!suffix.contains("content-range:"));
    testing::assert(suffix.ends_with("\r\n\r\n"));
}
