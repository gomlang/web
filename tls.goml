package web;

use std::bytes::{Bytes};
use std::context;
use std::io;
use std::net::{TcpListener, TcpStream, WaitOptions};
use std::net::tls;
use std::time::{Duration};

pub struct TlsConfig {
    certificate: Bytes,
    private_key: Bytes,
    minimum: tls::Version,
    handshake_timeout: Duration,
}

impl TlsConfig {
    pub fn new(certificate_pem: Bytes, private_key_pem: Bytes) -> TlsConfig {
        TlsConfig {
            certificate: certificate_pem.copy(),
            private_key: private_key_pem.copy(),
            minimum: tls::Version::Tls12,
            handshake_timeout: Duration::from_seconds(10),
        }
    }

    pub fn with_minimum_version(self: TlsConfig, minimum: tls::Version) -> TlsConfig {
        TlsConfig { minimum, ..self }
    }

    pub fn with_handshake_timeout(self: TlsConfig, timeout: Duration) -> TlsConfig {
        TlsConfig { handshake_timeout: timeout, ..self }
    }
}

enum ServerListener {
    Tcp(TcpListener),
    Tls(tls::TlsListener),
}

enum ConnectionStream {
    Tcp(TcpStream),
    Tls(tls::TlsStream),
}

impl ServerListener {
    fn address(self: ServerListener) -> Result[string, Error] {
        match self {
            Tcp(listener) => listener.local_addr().map(|address| address.to_string()).map_err(
                transport_error,
            ),
            Tls(listener) => listener.local_addr().map(|address| address.to_string()).map_err(
                transport_error,
            ),
        }
    }

    fn close(self: ServerListener) -> Result[(), io::Error] {
        match self {
            Tcp(listener) => listener.close(),
            Tls(listener) => listener.close(),
        }
    }

    fn accept(self: ServerListener) -> Result[(ConnectionStream, string), Error] {
        match self {
            Tcp(listener) => listener.accept().map(
                |pair| (ConnectionStream::Tcp(pair.0), pair.1.to_string()),
            ).map_err(transport_error),
            Tls(listener) => {
                let stream = listener.accept_pending().map_err(transport_error)?;
                let address = match stream.peer_addr() {
                    Ok(address) => address.to_string(),
                    Err(error) => {
                        let _ = stream.abort();
                        return Result::Err(transport_error(error))
                    },
                };
                Result::Ok((ConnectionStream::Tls(stream), address))
            },
        }
    }
}

impl ConnectionStream {
    fn handshake(self: ConnectionStream) -> Result[(), Error] {
        match self {
            Tcp(_) => Result::Ok(()),
            Tls(stream) => stream.handshake().map_err(transport_error),
        }
    }

    fn close(self: ConnectionStream) -> Result[(), io::Error] {
        match self {
            Tcp(stream) => stream.close(),
            Tls(stream) => stream.abort(),
        }
    }

    fn read_with(self: ConnectionStream, data: MutSlice[byte], context: context::Context) -> Result[
        isize,
        io::Error,
    ] {
        context.check().map_err(|error| io_error(context_error(error), "read connection"))?;
        match self {
            Tcp(stream) => stream.read_with(data, WaitOptions::new().with_context(context)),
            Tls(stream) => stream.read_with(data, context),
        }
    }

    fn write_with(self: ConnectionStream, data: Slice[byte], context: context::Context) -> Result[
        isize,
        io::Error,
    ] {
        context.check().map_err(|error| io_error(context_error(error), "write connection"))?;
        match self {
            Tcp(stream) => stream.write_with(data, WaitOptions::new().with_context(context)),
            Tls(stream) => stream.write_with(data, context),
        }
    }

    fn write_all_with(self: ConnectionStream, data: Slice[byte], context: context::Context) -> Result[
        (),
        io::Error,
    ] {
        let mut offset = 0;
        while offset < data.len() {
            let count = self.write_with(data.sub(offset, data.len()), context)?;
            if count == 0 {
                return Result::Err(
                    io_error(
                        Error::new(ErrorKind::Transport, "connection write made no progress"),
                        "write connection",
                    ),
                )
            }
            offset += count;
        }
        Result::Ok(())
    }
}

impl Router {
    pub fn serve_tls(self: Router, address: string, config: TlsConfig) -> Result[Server, Error] {
        self.validate()?;
        if config.handshake_timeout.is_zero() {
            return Result::Err(
                Error::new(ErrorKind::Configuration, "TLS handshake timeout must be positive"),
            )
        }
        let configuration = tls::ServerConfig::new(
            config.certificate.as_slice(),
            config.private_key.as_slice(),
        ).with_versions(config.minimum, tls::Version::Tls13).with_alpn(
            Vec::from_array(["http/1.1"]),
        ).with_handshake_timeout(config.handshake_timeout);
        let listener = tls::TlsListener::bind(listen_address(address)?, configuration).map_err(
            transport_error,
        )?;
        start_listener(self, ServerListener::Tls(listener))
    }
}
