package tests;

use ecosystem::web::{Router, Response, Error, ErrorKind, Limits};
use std::bytes::{Bytes};
use std::testing;
use std::time::{Duration};

fn body_failure_cases() -> Vec[(string, ErrorKind)] {
    Vec::from_array(
        [
            ("z\r\n0\r\n\r\n", ErrorKind::BadRequest),
            ("z\n0\r\n\r\n", ErrorKind::BadRequest),
            ("1;name=\r\n0\r\n\r\n", ErrorKind::BadRequest),
            ("0\r\nContent-Length: 1\r\n0\r\n\r\n", ErrorKind::BadRequest),
            ("0\r\nBad Header: value\r\n0\r\n\r\n", ErrorKind::BadRequest),
            ("1\r\nx!!\r\n0\r\n\r\n", ErrorKind::BadRequest),
            ("6\r\n0\r\n\r\n", ErrorKind::BodyLimit),
        ],
    )
}

fn failed_body_request(body: string, close: bool) -> string {
    "POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n"
        + if close {
            "Connection: close\r\n"
        } else {
            ""
        }
        + "\r\n"
        + body
}

#[test]
fn body_failure_remains_terminal_for_aliases_and_repeated_reads() -> () {
    let observed: Channel[(Result[Bytes, Error], Result[Bytes, Error])] = Channel::new(1);
    let server = transport_server(
        Router::new().post(
            "/",
            |request| {
                let body = request.body();
                let alias = request.body();
                let first = body.collect(8);
                let second = alias.read(8);
                observed.send((first, second));
                Result::Ok(Response::text(200, "handled"))
            },
        ).limits(Limits { body_bytes: 4, ..Limits::new() }),
    );
    defer {
        let _ = server.shutdown(Duration::from_seconds(2));
    };
    for entry in body_failure_cases() {
        let response = transport_request(server, failed_body_request(entry.0, false));
        testing::assert(response.starts_with("HTTP/1.1 200 "));
        testing::assert(response.to_ascii_lowercase().contains("connection: close\r\n"));
        let results = transport_receive(observed);
        let first = testing::expect_err(results.0, "malformed body rejected");
        let second = testing::expect_err(results.1, "body failure remains terminal");
        testing::assert_eq(first.kind, entry.1);
        testing::assert_eq(second.kind, first.kind);
        testing::assert_eq(second.message, first.message);
    }
}

#[test]
fn body_failure_validation_and_extraction_errors_preserve_valid_framing() -> () {
    let server = transport_server(
        Router::new().post(
            "/",
            |request| {
                let body = request.body();
                for size in[0, 65537] {
                    testing::assert_eq(
                        testing::expect_err(body.read(size), "invalid read size").kind,
                        ErrorKind::Configuration,
                    );
                }
                testing::assert_eq(
                    testing::expect_err(body.collect(-1), "negative extraction limit").kind,
                    ErrorKind::Configuration,
                );
                testing::assert_eq(
                    testing::expect_err(body.collect(0), "extraction limit").kind,
                    ErrorKind::BodyLimit,
                );
                Result::Ok(Response::new(200).body(body.collect(4)?))
            },
        ).get("/next", |_| Result::Ok(Response::text(200, "next request executed"))).limits(
            Limits { body_bytes: 4, ..Limits::new() },
        ),
    );
    defer {
        let _ = server.shutdown(Duration::from_seconds(2));
    };
    for request in[
        failed_body_request("4\r\nabcd\r\n0\r\n\r\n", false),
        "POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 4\r\n\r\nabcd",
    ] {
        let response = transport_request(
            server,
            request + "GET /next HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
        );
        testing::assert(response.starts_with("HTTP/1.1 200 "));
        testing::assert(response.contains("connection: keep-alive\r\n\r\nbcdHTTP/1.1 200 "));
        testing::assert(response.ends_with("next request executed"));
    }
}

#[test]
fn body_failure_prevents_pipelined_request_dispatch() -> () {
    let dispatched = Channel::new(1);
    let server = transport_server(
        Router::new().post(
            "/",
            |request| {
                Result::Ok(Response::new(200).body(request.body().collect(8)?))
            },
        ).get(
            "/next",
            |_| {
                dispatched.send(());
                Result::Ok(Response::text(200, "next request executed"))
            },
        ).limits(Limits { body_bytes: 4, ..Limits::new() }),
    );
    defer {
        let _ = server.shutdown(Duration::from_seconds(2));
    };
    for entry in body_failure_cases() {
        let response = transport_request(
            server,
            failed_body_request(entry.0, false)
                + "GET /next HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
        );
        testing::assert(
            response.starts_with(
                if entry.1 == ErrorKind::BodyLimit {
                    "HTTP/1.1 413 "
                } else {
                    "HTTP/1.1 400 "
                },
            ),
        );
        let executed = select {
            recv(dispatched) as _ => true,
            default => false,
        };
        testing::assert(!executed);
        testing::assert(!response.contains("next request executed"));
        testing::assert(response.to_ascii_lowercase().contains("connection: close\r\n"));
    }
}
